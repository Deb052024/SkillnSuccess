PORT=8080

# SQLite file — created automatically on first run.
DATABASE_FILE=./data/skillnsuccess.db

# --- Feature flag: keep this "false" until you're ready to take real payments. ---
# The site works fully without Razorpay — the pricing CTA shows a waitlist
# capture instead of a checkout button while this is false.
ENABLE_PAYMENTS=false

# --- Razorpay (only needed once ENABLE_PAYMENTS=true) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Anthropic (only needed for AI Success Plan generation, which is gated
# behind a paid entitlement — so also dormant until payments are enabled) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- E-book: The Dealer Network Playbook (US$4) ---
# Paste the hosted checkout link from Lemon Squeezy or Gumroad (they take cards,
# Apple Pay, Google Pay and PayPal worldwide, handle VAT/sales tax, and email the
# PDF to the buyer). Leave blank and the page shows a "notify me" fallback.
DEALER_PLAYBOOK_CHECKOUT_URL=
# Optional extra button, e.g. https://www.paypal.com/ncp/payment/XXXX or https://paypal.me/yourname/4USD
DEALER_PLAYBOOK_PAYPAL_URL=

PRICE_PAISE=11000
CURRENCY=INR

# Your live domain(s), comma-separated.
ALLOWED_ORIGINS=https://skillnsuccess.com,https://www.skillnsuccess.com,http://localhost:8080
